{
  "name": "ugoku-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:docs": "pnpm --filter ugoku-docs dev",
    "test:e2e": "pnpm --filter ugoku-e2e test",
    "test:e2e:astro": "pnpm --filter ugoku-e2e-astro test",
    "test:all": "pnpm typecheck && pnpm test && pnpm test:e2e && pnpm test:e2e:astro",
    "build:edit-chunk": "pnpm --filter @ugoku/core build:edit-chunk",
    "build:ts-chunk": "pnpm --filter @ugoku/core build:ts-chunk",
    "verify:standalone-chunks": "pnpm build:edit-chunk && pnpm build:ts-chunk && node scripts/verify-standalone-chunks.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
