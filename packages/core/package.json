{
  "name": "@ugoku/core",
  "version": "0.2.0",
  "description": "Local-first runtime for runnable code snippets in Shiki-highlighted sites: Web Worker execution, streamed console output, and an editable overlay.",
  "keywords": [
    "shiki",
    "runnable-code",
    "code-playground",
    "interactive-code",
    "live-code-editor",
    "console",
    "web-worker",
    "javascript",
    "typescript",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ugokujs/ugoku.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./edit": "./src/edit/editor.ts",
    "./ts": "./src/ts/strip.ts",
    "./styles.css": "./src/output-panel/styles.css"
  },
  "scripts": {
    "build:edit-chunk": "node scripts/build-edit-chunk.mjs",
    "build:ts-chunk": "node scripts/build-ts-chunk.mjs"
  },
  "dependencies": {
    "shiki": "^4.5.0",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
