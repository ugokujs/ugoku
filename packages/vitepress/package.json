{
  "name": "@ugoku/vitepress",
  "version": "0.2.1",
  "description": "VitePress adapter for ugoku: runnable, editable code snippets in your VitePress docs, no server involved.",
  "keywords": [
    "vitepress",
    "vitepress-plugin",
    "shiki",
    "runnable-code",
    "documentation",
    "docs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ugokujs/ugoku.git",
    "directory": "packages/vitepress"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "dependencies": {
    "@ugoku/core": "workspace:*",
    "@ugoku/shiki": "workspace:*"
  }
}
